BACKEND_LOG_URL=http://localhost:3000/api/internal/logs
SERVICE_API_KEY=change-me-same-value-as-web-SERVICE_API_KEY
MAX_MESSAGE_LEN=2000

# SPOTER Model Configuration
SPOTER_MODEL_NAME=spoter_arsl
SPOTER_MODEL_VERSION=v1
SPOTER_CHECKPOINT_PATH=models/spoter_arsl_v1.pth
SPOTER_CONFIDENCE_THRESHOLD=0.3
# Ambiguity margin: predictions whose top-2 gap is below this are ambiguous (KAN-24)
SPOTER_AMBIGUITY_MARGIN=0.15

# NLP layer (KAN-19): gloss sequence -> Armenian sentence
# LLM_PROVIDER: "gemini", or "none" to disable the NLP layer
LLM_PROVIDER=gemini
# Secret: put the real key only in your local .env and in the Render dashboard
GEMINI_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite
LLM_TIMEOUT_SECONDS=10

# Gesture lifecycle management (KAN-26) — empirically adjustable thresholds
LIFECYCLE_ACTIVE_AREA_MARGIN=0.08
LIFECYCLE_MIN_SHOULDER_SPAN=0.08
LIFECYCLE_START_HOLD_MS=200
LIFECYCLE_INACTIVITY_MS=1200
LIFECYCLE_FINALIZE_TIMEOUT_MS=2000
LIFECYCLE_NEUTRAL_END_FRAMES=6
