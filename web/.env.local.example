NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

# Backend (API routes)
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/signum"
JWT_SECRET="change-me-to-a-long-random-string-32-chars-min"
SERVICE_API_KEY="change-me-to-another-long-random-string"

# Logging
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_MAX_SIZE_MB=50
LOG_RETENTION_DAYS=30
DB_SLOW_QUERY_MS=200

# Sign in with Google (OAuth 2.0 "Web application" client ID from Google Cloud Console).
# Leave empty to hide the Google button; the same value is used by the browser and the API.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
